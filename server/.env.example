PORT=5109
# REQUIRED — dùng chuỗi ngẫu nhiên dài, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=your_secret_key_here_change_this
CLIENT_ORIGIN=http://localhost:5101
JWT_EXPIRES_IN=30d

# URL công khai của server (dùng cho OAuth callback)
SERVER_BASE=http://localhost:5109

# Google OAuth — lấy tại https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:5109/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — lấy tại https://developers.facebook.com/
# Valid OAuth Redirect URI: http://localhost:5109/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Garage S3-compatible storage — bỏ trống để dùng local disk (server/uploads/)
# Sau khi chạy: docker exec garage garage bucket allow giapha --read --write --key new
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_REGION=garage
GARAGE_KEY_ID=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=giapha
# URL công khai để client tải ảnh (Garage web endpoint hoặc domain reverse proxy)
# Mặc định: GARAGE_ENDPOINT/GARAGE_BUCKET
GARAGE_PUBLIC_URL=http://localhost:3902/giapha
