PORT=5109
CLIENT_ORIGIN=http://localhost:5101
JWT_EXPIRES_IN=30d

# REQUIRED — node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secret_key_here_change_this

# URL công khai của server (dùng cho OAuth callback)
SERVER_BASE=http://localhost:5109

# Session secret (mặc định dùng JWT_SECRET nếu bỏ trống)
SESSION_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Authorized redirect URI: ${SERVER_BASE}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth ────────────────────────────────────────────────────────────
# Valid OAuth Redirect URI: ${SERVER_BASE}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Garage S3 storage (bỏ trống để dùng local disk) ──────────────────────────
GARAGE_ENDPOINT=
GARAGE_REGION=garage
GARAGE_BUCKET=giapha
GARAGE_KEY_ID=
GARAGE_SECRET_KEY=
GARAGE_PUBLIC_URL=
