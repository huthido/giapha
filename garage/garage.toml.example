metadata_dir = "/var/lib/garage/meta"
data_dir     = "/var/lib/garage/data"
db_engine    = "lmdb"

replication_factor = 1
rpc_bind_addr      = "[::]:3901"

# Tạo bằng: openssl rand -hex 32
rpc_secret = "REPLACE_WITH_OPENSSL_RAND_HEX_32"

[s3_api]
s3_region   = "garage"
api_bind_addr = "[::]:3900"
# Cho phép đọc public (bucket 'giapha' đã set --read --anonymous qua garage-init.sh)
# → client load ảnh trực tiếp từ https://s3.your-domain.com/giapha/{key}
allow_unauthenticated_reads = true

[s3_web]
bind_addr   = "[::]:3902"
root_domain = ".web.localhost"
index       = "index.html"

[admin]
api_bind_addr = "[::]:3903"
