# ─── Stage 1: Build React/Vite ───────────────────────────────────────────────
FROM node:22-slim AS builder

RUN npm install -g pnpm@10

WORKDIR /build

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY client/package.json ./client/
COPY server/package.json ./server/
RUN pnpm install --frozen-lockfile

COPY client/ ./client/

# VITE_SERVER_URL="" → OAuth dùng URL tương đối (/api/auth/google)
# nên hoạt động qua nginx proxy dù triển khai ở bất kỳ domain nào.
# Ghi đè tại build time nếu cần: --build-arg VITE_SERVER_URL=https://your-domain.com
ARG VITE_SERVER_URL=""
ENV VITE_SERVER_URL=${VITE_SERVER_URL}

RUN pnpm --filter giapha-client build

# ─── Stage 2: Nginx serving static files ─────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=builder /build/client/dist /usr/share/nginx/html
COPY client/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
